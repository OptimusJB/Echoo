;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spoutoufy"
config/description="logiciel d'écoute de musique"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60
run/low_processor_mode=true
config/icon="uid://bmnvu85tquim8"

[autoload]

Settings="*uid://bqv58q2yiuhrd"
Notif="*uid://vqojgkpibm0b"

[display]

window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg")

[input]

echelle_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194321,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
echelle_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194319,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
